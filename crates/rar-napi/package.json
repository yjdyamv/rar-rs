{
  "name": "rar-rs",
  "version": "0.12.0",
  "description": "Pure-Rust RAR archive toolkit for Node.js — create, read, extract, test, modify and repair RAR5/RAR7 and legacy RAR 1.3–4.x archives, with no external rar/unrar binary",
  "license": "BSD-2-Clause",
  "main": "rar-rs.js",
  "types": "rar-rs.d.ts",
  "browser": "browser.js",
  "exports": {
    ".": {
      "types": "./rar-rs.d.ts",
      "browser": "./browser.js",
      "default": "./rar-rs.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "rar-rs.js",
    "rar-rs.d.ts",
    "binding.js",
    "binding.d.ts",
    "binding.wasi.cjs",
    "binding.wasi-browser.js",
    "binding.wasi.d.cts",
    "wasi-worker.mjs",
    "wasi-worker-browser.mjs",
    "wasi-path-map.cjs",
    "browser.js",
    "README.md"
  ],
  "keywords": [
    "rar",
    "unrar",
    "archive",
    "compression",
    "extract",
    "napi",
    "rust"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yjdyamv/rar-rs.git"
  },
  "homepage": "https://github.com/yjdyamv/rar-rs",
  "bugs": {
    "url": "https://github.com/yjdyamv/rar-rs/issues"
  },
  "napi": {
    "binaryName": "rar-rs-napi",
    "targets": [
      "x86_64-pc-windows-msvc",
      "i686-pc-windows-msvc",
      "aarch64-pc-windows-msvc",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-gnu",
      "aarch64-unknown-linux-musl",
      "armv7-unknown-linux-gnueabihf",
      "wasm32-wasip1-threads"
    ]
  },
  "engines": {
    "node": ">= 18"
  },
  "scripts": {
    "build": "napi build --platform --release --js binding.js --dts binding.d.ts",
    "build:debug": "napi build --platform --js binding.js --dts binding.d.ts",
    "build:wasi": "napi build --platform --release --target wasm32-wasip1-threads --js binding.wasi.cjs --dts binding.wasi.d.cts && node scripts/patch-wasi-loader.mjs",
    "test": "node --test __test__/*.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@emnapi/core": "2.0.0-alpha.3",
    "@emnapi/runtime": "2.0.0-alpha.3",
    "@napi-rs/cli": "^3.8.2",
    "@napi-rs/wasm-runtime": "^1.2.2",
    "@types/node": "^24.19.0",
    "typescript": "^7.0.0"
  },
  "packageManager": "npm@11.17.0"
}
