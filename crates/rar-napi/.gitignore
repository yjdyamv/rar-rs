node_modules/
target/
# Build artifacts — everything below is regenerated by `napi build`, so it must
# never be tracked. The hand-written files (`rar-rs.js`, `rar-rs.d.ts`,
# `wasi-path-map.cjs`) sit alongside them and are deliberately not listed.
#
# The WASI globs are what @napi-rs/cli actually emits for
# `wasm32-wasip1-threads`: the flavor loader is always `<binaryName>.wasi.*`,
# never the `--js` name (that would be the platform resolver, `binding.js`).
browser.js
index.js
index.d.ts
binding.js
binding.d.ts
*.wasi.cjs
*.wasi-browser.js
*.wasi.d.cts
wasi-worker*.mjs
*.node
*.wasm
